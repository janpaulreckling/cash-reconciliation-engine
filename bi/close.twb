<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.2.2 (20262.26.0819.2015)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AnimationOnByDefault />
    <BasicButtonObject />
    <BasicButtonObjectTextSupport />
    <CollapsiblePane />
    <MarkAnimation />
    <SetMembershipControl />
    <VizInTooltipHideWorksheet />
    <WindowsPersistSimpleIdentifiers />
    <WorksheetBackgroundTransparency />
    <ZoneVisibilityControl />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Metric view' datatype='string' name='[p_Metric_View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cash at stake (USD)&quot;'><calculation class='tableau' formula='&quot;Cash at stake (USD)&quot;' /><members><member value='&quot;Cash at stake (USD)&quot;' /><member value='&quot;Payment count (#)&quot;' /></members></column>
    </datasource>
    <datasource caption='cash_items' inline='true' name='federated.cash' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='cash_items' name='textscan.cash'>
            <connection class='textscan' directory='.' filename='cash_items.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.cash' name='cash_items.csv' table='[cash_items#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='source' ordinal='0' /><column datatype='string' name='source_id' ordinal='1' /><column datatype='date' name='cash_date' ordinal='2' /><column datatype='real' name='amount_usd' ordinal='3' /><column datatype='string' name='customer' ordinal='4' /><column datatype='string' name='status' ordinal='5' /><column datatype='string' name='match_tier' ordinal='6' /><column datatype='string' name='exception_code' ordinal='7' /><column datatype='string' name='exception_reason' ordinal='8' /><column datatype='string' name='severity' ordinal='9' /><column datatype='date' name='as_of_date' ordinal='10' /><column datatype='integer' name='age_days' ordinal='11' /><column datatype='string' name='aging_bucket' ordinal='12' /></columns>
        </relation>
      </connection>
      <column datatype='string' name='[source]' role='dimension' type='nominal' /><column datatype='string' name='[source_id]' role='dimension' type='nominal' caption='Ref ID' /><column datatype='date' name='[cash_date]' role='dimension' type='ordinal' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column datatype='string' name='[customer]' role='dimension' type='nominal' caption='Customer' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='string' name='[match_tier]' role='dimension' type='nominal' caption='Match tier' /><column datatype='string' name='[exception_code]' role='dimension' type='nominal' /><column datatype='string' name='[exception_reason]' role='dimension' type='nominal' caption='Reason' /><column datatype='string' name='[severity]' role='dimension' type='nominal' /><column datatype='date' name='[as_of_date]' role='dimension' type='ordinal' /><column datatype='integer' name='[age_days]' role='measure' type='quantitative' /><column datatype='string' name='[aging_bucket]' role='dimension' type='nominal' caption='Age' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column caption='Share of all payments' datatype='real' name='[Calc_share]' role='measure' type='quantitative' default-format='p0.0%'><calculation class='tableau' formula='SUM([Number of Records]) / MIN({FIXED : SUM([Number of Records])})'></calculation></column><column caption='Selected metric' datatype='real' name='[Calc_metric]' role='measure' type='quantitative' default-format='n#,##0'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN SUM([Number of Records]) ELSE SUM([amount_usd]) END'></calculation></column><column caption='Metric prefix' datatype='string' name='[Calc_prefix]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN &quot;&quot; ELSE &quot;$&quot; END'></calculation></column><column caption='SLA note' datatype='string' name='[Calc_sla_note]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [age_days] > 7 THEN &quot;   Past 7d SLA&quot; ELSE &quot;&quot; END'></calculation></column><column caption='Gap to target (pp)' datatype='real' name='[Calc_gap_pp]' role='measure' type='quantitative' default-format='n+#,##0&quot; pp&quot;;−#,##0&quot; pp&quot;'><calculation class='tableau' formula='ROUND(([Calc_rate] - 0.85) * 100, 0)'></calculation></column><column caption='Target auto-match rate' datatype='real' name='[Calc_target]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='MIN(0.85)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column caption='Customer / payer' datatype='string' name='[Calc_payer]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([customer]) OR [customer] = &quot;&quot; THEN &quot;Unknown payer&quot; ELSE [customer] END'></calculation></column><column caption='Close state' datatype='string' name='[Calc_close_state]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;Blocked&quot; ELSE &quot;Ready&quot; END'></calculation></column><column caption='Close status' datatype='string' name='[Calc_close_label]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;●  Close blocked · &quot; + STR([Calc_review]) + &quot; items · $&quot; + STR(INT(ROUND([Calc_review_usd] / 1000, 0))) + &quot;K to clear&quot; ELSE &quot;●  Ready to close&quot; END'></calculation></column><column caption='Cumulative cash' datatype='real' name='[Calc_wf_end]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='RUNNING_SUM(SUM([amount_usd]))'><table-calc ordering-field='[federated.cash].[none:status:nk]' ordering-type='Field' /></calculation></column><column caption='Cash received (month)' datatype='real' name='[Calc_wf_total]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='MIN({FIXED : SUM([amount_usd])})'></calculation></column><column caption='Step' datatype='real' name='[Calc_wf_size]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='-SUM([amount_usd])'></calculation></column><column caption='Step' datatype='string' name='[Calc_step]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [status] = &quot;Auto-matched&quot; THEN (CASE [match_tier] WHEN &quot;Tier 1 · Exact&quot; THEN &quot;Exact match&quot; WHEN &quot;Tier 2 · Fuzzy&quot; THEN &quot;Fuzzy match&quot; ELSE &quot;One-to-many&quot; END) ELSEIF [status] = &quot;Unmatched&quot; THEN &quot;Unmatched&quot; ELSE &quot;Needs review&quot; END'></calculation></column><column caption='Cash' datatype='real' name='[Calc_amt_k]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='SUM([amount_usd])'></calculation></column><column caption='Share of cash' datatype='real' name='[Calc_pct_total]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='SUM([amount_usd]) / MIN({FIXED : SUM([amount_usd])})'></calculation></column><column caption='Cumulative cash' datatype='real' name='[Calc_flow_end]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='RUNNING_SUM(SUM([amount_usd]))'><table-calc ordering-field='[federated.cash].[none:Calc_step:nk]' ordering-type='Field' /></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_k]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column caption='Age (days)' datatype='integer' name='[Calc_age]' role='measure' type='quantitative'><calculation class='tableau' formula='MIN([age_days])'></calculation></column><column caption='Rank by amount' datatype='integer' name='[Calc_rank]' role='measure' type='quantitative'><calculation class='tableau' formula='RANK_UNIQUE(SUM([amount_usd]))'><table-calc ordering-type='Rows' /></calculation></column>
      <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calc_close_state]' derivation='User' name='[usr:Calc_close_state:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calc_step]' derivation='None' name='[none:Calc_step:nk]' pivot='key' type='nominal' />
      <column-instance column='[aging_bucket]' derivation='None' name='[none:aging_bucket:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style><style-rule element='mark'>
        <encoding attr='color' field='[none:status:nk]' type='palette'><map to='#2C5F8A'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#9AA5B1'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;Unmatched&quot;</bucket></map></encoding>
        <encoding attr='color' field='[none:aging_bucket:nk]' type='palette'><map to='#FFD4A8'><bucket>&quot;0-3 days&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;4-7 days&quot;</bucket></map><map to='#D9622B'><bucket>&quot;8-14 days&quot;</bucket></map><map to='#A33D16'><bucket>&quot;15+ days&quot;</bucket></map></encoding>
        <encoding attr='color' field='[none:Calc_step:nk]' type='palette'><map to='#2C5F8A'><bucket>&quot;Exact match&quot;</bucket></map><map to='#4F81AF'><bucket>&quot;Fuzzy match&quot;</bucket></map><map to='#8DB3D6'><bucket>&quot;One-to-many&quot;</bucket></map><map to='#9AA5B1'><bucket>&quot;Needs review&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;Unmatched&quot;</bucket></map></encoding>
        <encoding attr='color' field='[usr:Calc_close_state:nk]' type='palette'><map to='#B91C1C'><bucket>&quot;Blocked&quot;</bucket></map><map to='#15803D'><bucket>&quot;Ready&quot;</bucket></map></encoding>
      </style-rule></style>
    </datasource>
  </datasources>
  <actions>
    <action caption='Filter from Cash flow by step' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Cash flow by step' />
      <link caption='Filter from Cash flow by step' delimiter=',' escape='\' expression='tsl:Close%20dashboard?%5Bfederated.cash%5D.%5BCalc_step%5D~s0=&lt;[Calc_step]~na&gt;' include-null='true' multi-select='true' url-escape='true' /><command command='tsc:tsl-filter'>
        <param name='exclude' value='Cash flow by step' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Filter from Exception queue by reason' name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Exception queue by reason' />
      <link caption='Filter from Exception queue by reason' delimiter=',' escape='\' expression='tsl:Close%20dashboard?%5Bfederated.cash%5D.%5Bexception_reason%5D~s0=&lt;[exception_reason]~na&gt;' include-null='true' multi-select='true' url-escape='true' /><command command='tsc:tsl-filter'>
        <param name='exclude' value='Exception queue by reason' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Filter from Unmatched cash aging' name='[Action3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Unmatched cash aging' />
      <link caption='Filter from Unmatched cash aging' delimiter=',' escape='\' expression='tsl:Close%20dashboard?%5Bfederated.cash%5D.%5Baging_bucket%5D~s0=&lt;[aging_bucket]~na&gt;' include-null='true' multi-select='true' url-escape='true' /><command command='tsc:tsl-filter'>
        <param name='exclude' value='Unmatched cash aging' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='KPI tiles: no selection' name='[Action9]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet'><exclude-sheet name='Cash flow by step' /><exclude-sheet name='Exception queue by reason' /><exclude-sheet name='Unmatched cash aging' /><exclude-sheet name='Action_Table' /></source>
      <link caption='KPI tiles: no selection' delimiter=',' escape='\' expression='tsl:Close%20dashboard?%5Bfederated.cash%5D.%5BCalc_false%5D~s0=&lt;[Calc_true]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Cash flow by step,Exception queue by reason,Unmatched cash aging,Action_Table' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Open &lt;[federated.cash].[none:source_id:nk]&gt; in the review app' name='[Action10]'>
      <activation type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Action_Table' />
      <link caption='Open in the review app' expression='https://northwind-cash-recon.streamlit.app/?item=&lt;[federated.cash].[none:source_id:nk]~na&gt;' url-escape='true' />
    </action>
  </actions>
  <worksheets>
    <worksheet name='Headline'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Gap to target (pp)' datatype='real' name='[Calc_gap_pp]' role='measure' type='quantitative' default-format='n+#,##0&quot; pp&quot;;−#,##0&quot; pp&quot;'><calculation class='tableau' formula='ROUND(([Calc_rate] - 0.85) * 100, 0)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column caption='Cash' datatype='real' name='[Calc_amt_k]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='SUM([amount_usd])'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_k]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_gap_pp]' derivation='User' name='[usr:Calc_gap_pp:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_amt_k]' derivation='User' name='[usr:Calc_amt_k:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_k]' derivation='User' name='[usr:Calc_review_k:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='table'><format attr='background-color' value='#F2F2F2' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.cash].[usr:Calc_amt_k:qk]' /><text column='[federated.cash].[usr:Calc_rate:qk]' /><text column='[federated.cash].[usr:Calc_review:qk]' /><text column='[federated.cash].[usr:Calc_review_k:qk]' /><lod column='[federated.cash].[none:Calc_true:nk]' /><lod column='[federated.cash].[none:Calc_false:nk]' /></encodings><customized-label><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='15'>&lt;[federated.cash].[usr:Calc_amt_k:qk]&gt;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='11'> received</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='11'>   |   </run><run fontcolor='#2C5F8A' fontname='Tableau Semibold' fontsize='15'>&lt;[federated.cash].[usr:Calc_rate:qk]&gt;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='11'> matched automatically (target 85%)</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='11'>   |   </run><run fontcolor='#D9622B' fontname='Tableau Semibold' fontsize='15'>&lt;[federated.cash].[usr:Calc_review:qk]&gt; payments · &lt;[federated.cash].[usr:Calc_review_k:qk]&gt;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='11'> waiting for a reviewer</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='10'>   (as of 17-Nov-2026)</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='text-align' value='left' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Cash flow by step'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Step' datatype='string' name='[Calc_step]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [status] = &quot;Auto-matched&quot; THEN (CASE [match_tier] WHEN &quot;Tier 1 · Exact&quot; THEN &quot;Exact match&quot; WHEN &quot;Tier 2 · Fuzzy&quot; THEN &quot;Fuzzy match&quot; ELSE &quot;One-to-many&quot; END) ELSEIF [status] = &quot;Unmatched&quot; THEN &quot;Unmatched&quot; ELSE &quot;Needs review&quot; END'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='string' name='[match_tier]' role='dimension' type='nominal' caption='Match tier' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Cumulative cash' datatype='real' name='[Calc_flow_end]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='RUNNING_SUM(SUM([amount_usd]))'><table-calc ordering-field='[federated.cash].[none:Calc_step:nk]' ordering-type='Field' /></calculation></column><column caption='Step' datatype='real' name='[Calc_wf_size]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='-SUM([amount_usd])'></calculation></column><column caption='Cash' datatype='real' name='[Calc_amt_k]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0,K'><calculation class='tableau' formula='SUM([amount_usd])'></calculation></column><column caption='Share of cash' datatype='real' name='[Calc_pct_total]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='SUM([amount_usd]) / MIN({FIXED : SUM([amount_usd])})'></calculation></column><column-instance column='[Calc_step]' derivation='None' name='[none:Calc_step:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[match_tier]' derivation='None' name='[none:match_tier:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_flow_end]' derivation='User' name='[usr:Calc_flow_end:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_wf_size]' derivation='User' name='[usr:Calc_wf_size:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_amt_k]' derivation='User' name='[usr:Calc_amt_k:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_pct_total]' derivation='User' name='[usr:Calc_pct_total:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <sort class='manual' column='[federated.cash].[none:Calc_step:nk]' direction='ASC'><dictionary><bucket>&quot;Exact match&quot;</bucket><bucket>&quot;Fuzzy match&quot;</bucket><bucket>&quot;One-to-many&quot;</bucket><bucket>&quot;Needs review&quot;</bucket><bucket>&quot;Unmatched&quot;</bucket></dictionary></sort>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:Calc_step:nk]' type='palette'><map to='#2C5F8A'><bucket>&quot;Exact match&quot;</bucket></map><map to='#4F81AF'><bucket>&quot;Fuzzy match&quot;</bucket></map><map to='#8DB3D6'><bucket>&quot;One-to-many&quot;</bucket></map><map to='#9AA5B1'><bucket>&quot;Needs review&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;Unmatched&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><encoding attr='space' class='0' field='[federated.cash].[usr:Calc_flow_end:qk]' field-type='quantitative' max='290000.0' min='0.0' range-type='fixed' scope='rows' type='space' /><format attr='display' class='0' field='[federated.cash].[usr:Calc_flow_end:qk]' scope='rows' value='false' /></style-rule><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='header'><format attr='border-style' value='none' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='rows' value='off' /><format attr='line-visibility' scope='cols' value='off' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='GanttBar' />
            <encodings><color column='[federated.cash].[none:Calc_step:nk]' /><size column='[federated.cash].[usr:Calc_wf_size:qk]' /><text column='[federated.cash].[usr:Calc_amt_k:qk]' /><text column='[federated.cash].[usr:Calc_pct_total:qk]' /><tooltip column='[federated.cash].[sum:Number of Records:qk]' /><tooltip column='[federated.cash].[sum:amount_usd:qk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='11'>&lt;[federated.cash].[none:Calc_step:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt; across &lt;[federated.cash].[sum:Number of Records:qk]&gt; payment(s), &lt;[federated.cash].[usr:Calc_pct_total:qk]&gt; of all cash received</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>Click to filter the page</run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='12'>&lt;[federated.cash].[usr:Calc_amt_k:qk]&gt;</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>&lt;[federated.cash].[usr:Calc_pct_total:qk]&gt; of total</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='mark-labels-mode' value='all' /><format attr='size' value='0.62' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[usr:Calc_flow_end:qk]</rows>
        <cols>[federated.cash].[none:Calc_step:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Exception queue by reason'>
      <layout-options><title><formatted-text><run fontcolor='#2C5F8A' fontname='Tableau Semibold' fontsize='13'>Which reasons hold up the close?</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='10'>   &lt;[Parameters].[p_Metric_View]&gt;</run><run fontcolor='#9AA5B1' fontname='Tableau Book' fontsize='10'>    ■ </run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>needs review</run><run fontcolor='#F5A65B' fontname='Tableau Book' fontsize='10'>   ■ </run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>unmatched · click a bar to filter</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /><datasource name='Parameters' /></datasources>
          <datasource-dependencies datasource='Parameters'><column caption='Metric view' datatype='string' name='[p_Metric_View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cash at stake (USD)&quot;'><calculation class='tableau' formula='&quot;Cash at stake (USD)&quot;' /><members><member value='&quot;Cash at stake (USD)&quot;' /><member value='&quot;Payment count (#)&quot;' /></members></column></datasource-dependencies><datasource-dependencies datasource='federated.cash'><column datatype='string' name='[exception_reason]' role='dimension' type='nominal' caption='Reason' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Selected metric' datatype='real' name='[Calc_metric]' role='measure' type='quantitative' default-format='n#,##0'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN SUM([Number of Records]) ELSE SUM([amount_usd]) END'></calculation></column><column caption='Metric prefix' datatype='string' name='[Calc_prefix]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN &quot;&quot; ELSE &quot;$&quot; END'></calculation></column><column-instance column='[exception_reason]' derivation='None' name='[none:exception_reason:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_metric]' derivation='User' name='[usr:Calc_metric:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_prefix]' derivation='None' name='[none:Calc_prefix:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Matched, needs review&quot;' /><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><sort class='computed' column='[federated.cash].[none:exception_reason:nk]' direction='DESC' using='[federated.cash].[usr:Calc_metric:qk]' /><slices><column>[federated.cash].[none:status:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:status:nk]' type='palette'><map to='#2C5F8A'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#9AA5B1'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;Unmatched&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><format attr='display' class='0' field='[federated.cash].[usr:Calc_metric:qk]' scope='cols' value='false' /></style-rule><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='header'><format attr='border-style' value='none' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='rows' value='off' /><format attr='line-visibility' scope='cols' value='off' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.cash].[none:status:nk]' /><text column='[federated.cash].[none:Calc_prefix:nk]' /><text column='[federated.cash].[usr:Calc_metric:qk]' /><tooltip column='[federated.cash].[sum:Number of Records:qk]' /><tooltip column='[federated.cash].[sum:amount_usd:qk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='11'>&lt;[federated.cash].[none:exception_reason:nk]&gt; · &lt;[federated.cash].[none:status:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt; across &lt;[federated.cash].[sum:Number of Records:qk]&gt; payment(s), November 2026 close</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>Largest open items</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'><![CDATA[<Sheet name="Tooltip_Open_Items" maxwidth="420" maxheight="200" filter="<All Fields>">]]></run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#333333' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[none:Calc_prefix:nk]&gt;&lt;[federated.cash].[usr:Calc_metric:qk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='size' value='0.6' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[none:exception_reason:nk]</rows>
        <cols>[federated.cash].[usr:Calc_metric:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Unmatched cash aging'>
      <layout-options><title><formatted-text><run fontcolor='#2C5F8A' fontname='Tableau Semibold' fontsize='13'>How long has unmatched cash been waiting?</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='10'>&lt;[Parameters].[p_Metric_View]&gt; · items older than 7 days are past the SLA</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /><datasource name='Parameters' /></datasources>
          <datasource-dependencies datasource='Parameters'><column caption='Metric view' datatype='string' name='[p_Metric_View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cash at stake (USD)&quot;'><calculation class='tableau' formula='&quot;Cash at stake (USD)&quot;' /><members><member value='&quot;Cash at stake (USD)&quot;' /><member value='&quot;Payment count (#)&quot;' /></members></column></datasource-dependencies><datasource-dependencies datasource='federated.cash'><column datatype='string' name='[aging_bucket]' role='dimension' type='nominal' caption='Age' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Selected metric' datatype='real' name='[Calc_metric]' role='measure' type='quantitative' default-format='n#,##0'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN SUM([Number of Records]) ELSE SUM([amount_usd]) END'></calculation></column><column caption='Metric prefix' datatype='string' name='[Calc_prefix]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN &quot;&quot; ELSE &quot;$&quot; END'></calculation></column><column caption='SLA note' datatype='string' name='[Calc_sla_note]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [age_days] > 7 THEN &quot;   Past 7d SLA&quot; ELSE &quot;&quot; END'></calculation></column><column-instance column='[aging_bucket]' derivation='None' name='[none:aging_bucket:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_metric]' derivation='User' name='[usr:Calc_metric:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_prefix]' derivation='None' name='[none:Calc_prefix:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_sla_note]' derivation='None' name='[none:Calc_sla_note:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><sort class='manual' column='[federated.cash].[none:aging_bucket:nk]' direction='ASC'><dictionary><bucket>&quot;0-3 days&quot;</bucket><bucket>&quot;4-7 days&quot;</bucket><bucket>&quot;8-14 days&quot;</bucket><bucket>&quot;15+ days&quot;</bucket></dictionary></sort><slices><column>[federated.cash].[none:status:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:aging_bucket:nk]' type='palette'><map to='#FFD4A8'><bucket>&quot;0-3 days&quot;</bucket></map><map to='#F5A65B'><bucket>&quot;4-7 days&quot;</bucket></map><map to='#D9622B'><bucket>&quot;8-14 days&quot;</bucket></map><map to='#A33D16'><bucket>&quot;15+ days&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><format attr='display' class='0' field='[federated.cash].[usr:Calc_metric:qk]' scope='rows' value='false' /></style-rule><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='header'><format attr='border-style' value='none' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#555555' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='rows' value='off' /><format attr='line-visibility' scope='cols' value='off' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.cash].[none:aging_bucket:nk]' /><text column='[federated.cash].[none:Calc_prefix:nk]' /><text column='[federated.cash].[usr:Calc_metric:qk]' /><text column='[federated.cash].[none:Calc_sla_note:nk]' /><tooltip column='[federated.cash].[sum:Number of Records:qk]' /><tooltip column='[federated.cash].[sum:amount_usd:qk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='11'>Received &lt;[federated.cash].[none:aging_bucket:nk]&gt; ago, still unmatched</run><run>Æ&#10;</run><run fontcolor='#555555' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt; across &lt;[federated.cash].[sum:Number of Records:qk]&gt; payment(s), as of Nov 17, 2026</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'>Largest open items</run><run>Æ&#10;</run><run fontcolor='#8A8A8A' fontname='Tableau Book' fontsize='9'><![CDATA[<Sheet name="Tooltip_Open_Items" maxwidth="420" maxheight="200" filter="<All Fields>">]]></run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#333333' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[none:Calc_prefix:nk]&gt;&lt;[federated.cash].[usr:Calc_metric:qk]&gt;</run><run fontcolor='#A33D16' fontname='Tableau Semibold' fontsize='9'>&lt;[federated.cash].[none:Calc_sla_note:nk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='size' value='0.55' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[usr:Calc_metric:qk]</rows>
        <cols>[federated.cash].[none:aging_bucket:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Close status'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Close status' datatype='string' name='[Calc_close_label]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;●  Close blocked · &quot; + STR([Calc_review]) + &quot; items · $&quot; + STR(INT(ROUND([Calc_review_usd] / 1000, 0))) + &quot;K to clear&quot; ELSE &quot;●  Ready to close&quot; END'></calculation></column><column caption='Close state' datatype='string' name='[Calc_close_state]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;Blocked&quot; ELSE &quot;Ready&quot; END'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column-instance column='[Calc_close_label]' derivation='User' name='[usr:Calc_close_label:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_close_state]' derivation='User' name='[usr:Calc_close_state:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[usr:Calc_close_state:nk]' type='palette'><map to='#B91C1C'><bucket>&quot;Blocked&quot;</bucket></map><map to='#15803D'><bucket>&quot;Ready&quot;</bucket></map></encoding></style-rule><style-rule element='table'><format attr='background-color' value='#FFFFFF' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><color column='[federated.cash].[usr:Calc_close_state:nk]' /><text column='[federated.cash].[usr:Calc_close_label:nk]' /><lod column='[federated.cash].[none:Calc_true:nk]' /><lod column='[federated.cash].[none:Calc_false:nk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#333333' fontname='Tableau Book' fontsize='10'>A close can be signed off once no payment waits for a reviewer.</run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#333333' fontname='Tableau Semibold' fontsize='11'>&lt;[federated.cash].[usr:Calc_close_label:nk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='text-align' value='right' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Tooltip_Open_Items'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Customer / payer' datatype='string' name='[Calc_payer]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([customer]) OR [customer] = &quot;&quot; THEN &quot;Unknown payer&quot; ELSE [customer] END'></calculation></column><column datatype='string' name='[source_id]' role='dimension' type='nominal' caption='Ref ID' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Age (days)' datatype='integer' name='[Calc_age]' role='measure' type='quantitative'><calculation class='tableau' formula='MIN([age_days])'></calculation></column><column caption='Rank by amount' datatype='integer' name='[Calc_rank]' role='measure' type='quantitative'><calculation class='tableau' formula='RANK_UNIQUE(SUM([amount_usd]))'><table-calc ordering-type='Rows' /></calculation></column><column-instance column='[Calc_payer]' derivation='None' name='[none:Calc_payer:nk]' pivot='key' type='nominal' /><column-instance column='[source_id]' derivation='None' name='[none:source_id:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_age]' derivation='User' name='[usr:Calc_age:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_rank]' derivation='User' name='[usr:Calc_rank:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Matched, needs review&quot;' /><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><filter class='categorical' column='[federated.cash].[:Measure Names]'><groupfilter function='union' user:op='manual'><groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.cash].[usr:Calc_age:qk]&quot;' /><groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.cash].[sum:amount_usd:qk]&quot;' /></groupfilter></filter><filter class='quantitative' column='[federated.cash].[usr:Calc_rank:qk]' included-values='in-range'><min>1</min><max>5</max></filter><sort class='computed' column='[federated.cash].[none:Calc_payer:nk]' direction='DESC' using='[federated.cash].[sum:amount_usd:qk]' /><sort class='computed' column='[federated.cash].[none:source_id:nk]' direction='DESC' using='[federated.cash].[sum:amount_usd:qk]' /><slices><column>[federated.cash].[none:status:nk]</column><column>[federated.cash].[:Measure Names]</column><column>[federated.cash].[usr:Calc_rank:qk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#333333' /></style-rule><style-rule element='header'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#555555' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#555555' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='true' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='cols' value='off' /><format attr='stroke-color' scope='rows' value='#E5E7EB' /></style-rule></style>
        <panes>

          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Customer / payer' datatype='string' name='[Calc_payer]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([customer]) OR [customer] = &quot;&quot; THEN &quot;Unknown payer&quot; ELSE [customer] END'></calculation></column><column datatype='string' name='[source_id]' role='dimension' type='nominal' caption='Ref ID' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Age (days)' datatype='integer' name='[Calc_age]' role='measure' type='quantitative'><calculation class='tableau' formula='MIN([age_days])'></calculation></column><column caption='Rank by amount' datatype='integer' name='[Calc_rank]' role='measure' type='quantitative'><calculation class='tableau' formula='RANK_UNIQUE(SUM([amount_usd]))'><table-calc ordering-type='Rows' /></calculation></column><column-instance column='[Calc_payer]' derivation='None' name='[none:Calc_payer:nk]' pivot='key' type='nominal' /><column-instance column='[source_id]' derivation='None' name='[none:source_id:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_age]' derivation='User' name='[usr:Calc_age:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_rank]' derivation='User' name='[usr:Calc_rank:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Matched, needs review&quot;' /><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><filter class='categorical' column='[federated.cash].[:Measure Names]'><groupfilter function='union' user:op='manual'><groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.cash].[usr:Calc_age:qk]&quot;' /><groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.cash].[sum:amount_usd:qk]&quot;' /></groupfilter></filter><filter class='quantitative' column='[federated.cash].[usr:Calc_rank:qk]' included-values='in-range'><min>1</min><max>5</max></filter><sort class='computed' column='[federated.cash].[none:Calc_payer:nk]' direction='DESC' using='[federated.cash].[sum:amount_usd:qk]' /><sort class='computed' column='[federated.cash].[none:source_id:nk]' direction='DESC' using='[federated.cash].[sum:amount_usd:qk]' /><slices><column>[federated.cash].[none:status:nk]</column><column>[federated.cash].[:Measure Names]</column><column>[federated.cash].[usr:Calc_rank:qk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#172033' /></style-rule><style-rule element='header'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#475569' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='9' /><format attr='color' value='#475569' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='true' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='cols' value='off' /><format attr='stroke-color' scope='rows' value='#E5E7EB' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.cash].[Multiple Values]' /></encodings>

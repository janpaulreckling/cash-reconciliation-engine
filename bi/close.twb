          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:aging_bucket:nk]' type='palette'><map to='#FDBA74'><bucket>&quot;0-3 days&quot;</bucket></map><map to='#EA580C'><bucket>&quot;4-7 days&quot;</bucket></map><map to='#9A3412'><bucket>&quot;8-14 days&quot;</bucket></map><map to='#7C2D12'><bucket>&quot;15+ days&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><format attr='display' class='0' field='[federated.cash].[usr:Calc_metric:qk]' scope='cols' value='false' /></style-rule><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#475569' /></style-rule><style-rule element='header'><format attr='border-style' value='none' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#475569' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='rows' value='off' /><format attr='line-visibility' scope='cols' value='off' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.cash].[none:aging_bucket:nk]' /><text column='[federated.cash].[none:Calc_prefix:nk]' /><text column='[federated.cash].[usr:Calc_metric:qk]' /><text column='[federated.cash].[none:Calc_sla_note:nk]' /><tooltip column='[federated.cash].[sum:Number of Records:qk]' /><tooltip column='[federated.cash].[sum:amount_usd:qk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#172033' fontname='Tableau Semibold' fontsize='11'>Received &lt;[federated.cash].[none:aging_bucket:nk]&gt; ago, still unmatched</run><run>Æ&#10;</run><run fontcolor='#475569' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt; across &lt;[federated.cash].[sum:Number of Records:qk]&gt; payment(s), as of Nov 17, 2026</run><run>Æ&#10;</run><run fontcolor='#64748B' fontname='Tableau Book' fontsize='9'>Largest open items</run><run>Æ&#10;</run><run fontcolor='#64748B' fontname='Tableau Book' fontsize='9'><![CDATA[<Sheet name="Tooltip_Open_Items" maxwidth="420" maxheight="200" filter="<All Fields>">]]></run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#172033' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[none:Calc_prefix:nk]&gt;&lt;[federated.cash].[usr:Calc_metric:qk]&gt;</run><run fontcolor='#9A3412' fontname='Tableau Semibold' fontsize='9'>&lt;[federated.cash].[none:Calc_sla_note:nk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='size' value='0.42' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[none:aging_bucket:nk]</rows>
        <cols>[federated.cash].[usr:Calc_metric:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Close status'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Close status' datatype='string' name='[Calc_close_label]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;●  Close blocked · &quot; + STR([Calc_review]) + &quot; items · $&quot; + STR(ROUND([Calc_review_usd] / 1000, 1)) + &quot;k to clear&quot; ELSE &quot;●  Ready to close&quot; END'></calculation></column><column caption='Close state' datatype='string' name='[Calc_close_state]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;Blocked&quot; ELSE &quot;Ready&quot; END'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column-instance column='[Calc_close_label]' derivation='User' name='[usr:Calc_close_label:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_close_state]' derivation='User' name='[usr:Calc_close_state:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[usr:Calc_close_state:nk]' type='palette'><map to='#B91C1C'><bucket>&quot;Blocked&quot;</bucket></map><map to='#15803D'><bucket>&quot;Ready&quot;</bucket></map></encoding></style-rule><style-rule element='table'><format attr='background-color' value='#F4F6FA' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><color column='[federated.cash].[usr:Calc_close_state:nk]' /><text column='[federated.cash].[usr:Calc_close_label:nk]' /><lod column='[federated.cash].[none:Calc_true:nk]' /><lod column='[federated.cash].[none:Calc_false:nk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#172033' fontname='Tableau Book' fontsize='10'>A close can be signed off once no payment waits for a reviewer.</run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#172033' fontname='Tableau Semibold' fontsize='11'>&lt;[federated.cash].[usr:Calc_close_label:nk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='text-align' value='right' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Cash waterfall'>
      <layout-options><title><formatted-text><run fontcolor='#172033' fontname='Tableau Semibold' fontsize='12'>Where November&apos;s cash went · USD</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Cumulative cash' datatype='real' name='[Calc_wf_end]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='RUNNING_SUM(SUM([amount_usd]))'><table-calc ordering-field='[federated.cash].[none:status:nk]' ordering-type='Field' /></calculation></column><column caption='Step' datatype='real' name='[Calc_wf_size]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='-SUM([amount_usd])'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Cash received (month)' datatype='real' name='[Calc_wf_total]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='MIN({FIXED : SUM([amount_usd])})'></calculation></column><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_wf_end]' derivation='User' name='[usr:Calc_wf_end:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_wf_size]' derivation='User' name='[usr:Calc_wf_size:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_wf_total]' derivation='User' name='[usr:Calc_wf_total:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <sort class='manual' column='[federated.cash].[none:status:nk]' direction='ASC'><dictionary><bucket>&quot;Auto-matched&quot;</bucket><bucket>&quot;Matched, needs review&quot;</bucket><bucket>&quot;Unmatched&quot;</bucket></dictionary></sort>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:status:nk]' type='palette'><map to='#1D4ED8'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#64748B'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#B45309'><bucket>&quot;Unmatched&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><encoding attr='space' class='0' field='[federated.cash].[usr:Calc_wf_end:qk]' field-type='quantitative' max='265000.0' min='0.0' range-type='fixed' scope='cols' type='space' /><format attr='display' class='0' field='[federated.cash].[usr:Calc_wf_end:qk]' scope='cols' value='false' /></style-rule><style-rule element='cell'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#475569' /></style-rule><style-rule element='header'><format attr='border-style' value='none' /></style-rule><style-rule element='label'><format attr='font-family' value='Tableau Book' /><format attr='font-size' value='10' /><format attr='color' value='#475569' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='table-div'><format attr='line-visibility' scope='rows' value='off' /><format attr='line-visibility' scope='cols' value='off' /></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='GanttBar' />
            <encodings><color column='[federated.cash].[none:status:nk]' /><size column='[federated.cash].[usr:Calc_wf_size:qk]' /><text column='[federated.cash].[sum:amount_usd:qk]' /><tooltip column='[federated.cash].[sum:Number of Records:qk]' /><tooltip column='[federated.cash].[usr:Calc_wf_end:qk]' /><tooltip column='[federated.cash].[usr:Calc_wf_total:qk]' /></encodings><customized-tooltip><formatted-text><run fontcolor='#172033' fontname='Tableau Semibold' fontsize='11'>&lt;[federated.cash].[none:status:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#475569' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt; across &lt;[federated.cash].[sum:Number of Records:qk]&gt; payment(s)</run><run>Æ&#10;</run><run fontcolor='#475569' fontname='Tableau Book' fontsize='10'>Running total &lt;[federated.cash].[usr:Calc_wf_end:qk]&gt; of &lt;[federated.cash].[usr:Calc_wf_total:qk]&gt; received</run></formatted-text></customized-tooltip><customized-label><formatted-text><run fontcolor='#172033' fontname='Tableau Book' fontsize='10'>&lt;[federated.cash].[sum:amount_usd:qk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='mark-labels-mode' value='all' /><format attr='size' value='0.85' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[none:status:nk]</rows>
        <cols>[federated.cash].[usr:Calc_wf_end:qk]</cols>
      </table>

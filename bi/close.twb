<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.2.2 (20262.26.0819.2015)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='cash_items' inline='true' name='federated.cash' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='cash_items' name='textscan.cash'>
            <connection class='textscan' directory='.' filename='cash_items.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.cash' name='cash_items.csv' table='[cash_items#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='source' ordinal='0' /><column datatype='string' name='source_id' ordinal='1' /><column datatype='date' name='cash_date' ordinal='2' /><column datatype='real' name='amount_usd' ordinal='3' /><column datatype='string' name='customer' ordinal='4' /><column datatype='string' name='status' ordinal='5' /><column datatype='string' name='match_tier' ordinal='6' /><column datatype='string' name='exception_code' ordinal='7' /><column datatype='string' name='exception_reason' ordinal='8' /><column datatype='string' name='severity' ordinal='9' /><column datatype='date' name='as_of_date' ordinal='10' /><column datatype='integer' name='age_days' ordinal='11' /><column datatype='string' name='aging_bucket' ordinal='12' /></columns>
        </relation>
      </connection>
      <column datatype='string' name='[source]' role='dimension' type='nominal' /><column datatype='string' name='[source_id]' role='dimension' type='nominal' /><column datatype='date' name='[cash_date]' role='dimension' type='ordinal' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column datatype='string' name='[customer]' role='dimension' type='nominal' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='string' name='[match_tier]' role='dimension' type='nominal' caption='Match tier' /><column datatype='string' name='[exception_code]' role='dimension' type='nominal' /><column datatype='string' name='[exception_reason]' role='dimension' type='nominal' caption='Reason' /><column datatype='string' name='[severity]' role='dimension' type='nominal' /><column datatype='date' name='[as_of_date]' role='dimension' type='ordinal' /><column datatype='integer' name='[age_days]' role='measure' type='quantitative' /><column datatype='string' name='[aging_bucket]' role='dimension' type='nominal' caption='Age' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1' /></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))' /></column><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])' /></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]' /></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF([status]&lt;&gt;&quot;Auto-matched&quot;,[amount_usd],0))' /></column>
      <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style><style-rule element='mark'>
        <encoding attr='color' field='[none:status:nk]' type='palette'><map to='#0ca30c'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#fab219'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#d03b3b'><bucket>&quot;Unmatched&quot;</bucket></map></encoding>
      </style-rule></style>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Headline'>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])' /></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))' /></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1' /></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]' /></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF([status]&lt;&gt;&quot;Auto-matched&quot;,[amount_usd],0))' /></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.cash].[usr:Calc_rate:qk]' /><text column='[federated.cash].[usr:Calc_auto:qk]' /><text column='[federated.cash].[sum:Number of Records:qk]' /><text column='[federated.cash].[usr:Calc_review:qk]' /><text column='[federated.cash].[usr:Calc_review_usd:qk]' /></encodings><customized-label><formatted-text><run bold='true' fontsize='26'>&lt;[federated.cash].[usr:Calc_rate:qk]&gt;</run><run fontsize='13'> of payments auto-matched (</run><run fontsize='13'>&lt;[federated.cash].[usr:Calc_auto:qk]&gt;</run><run fontsize='13'> of </run><run fontsize='13'>&lt;[federated.cash].[sum:Number of Records:qk]&gt;</run><run fontsize='13'>)  ·  </run><run bold='true' fontsize='13'>&lt;[federated.cash].[usr:Calc_review:qk]&gt;</run><run fontsize='13'> to review, </run><run bold='true' fontsize='13'>&lt;[federated.cash].[usr:Calc_review_usd:qk]&gt;</run><run fontsize='13'> of cash</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='true' />
              <format attr='text-align' value='left' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Match rate by tier'>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column datatype='string' name='[match_tier]' role='dimension' type='nominal' caption='Match tier' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1' /></column><column-instance column='[match_tier]' derivation='None' name='[none:match_tier:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <sort class='manual' column='[federated.cash].[none:match_tier:nk]' direction='ASC'><dictionary><bucket>&quot;Tier 1 · Exact&quot;</bucket><bucket>&quot;Tier 2 · Fuzzy&quot;</bucket><bucket>&quot;Tier 3 · One-to-many&quot;</bucket><bucket>&quot;Not matched&quot;</bucket></dictionary></sort>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:status:nk]' type='palette'><map to='#0ca30c'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#fab219'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#d03b3b'><bucket>&quot;Unmatched&quot;</bucket></map></encoding></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.cash].[none:status:nk]' /><text column='[federated.cash].[sum:Number of Records:qk]' /></encodings>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='true' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[none:match_tier:nk]</rows>
        <cols>[federated.cash].[sum:Number of Records:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Exception queue by reason'>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column datatype='string' name='[exception_reason]' role='dimension' type='nominal' caption='Reason' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column-instance column='[exception_reason]' derivation='None' name='[none:exception_reason:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Matched, needs review&quot;' /><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><sort class='computed' column='[federated.cash].[none:exception_reason:nk]' direction='DESC' using='[federated.cash].[sum:amount_usd:qk]' /><slices><column>[federated.cash].[none:status:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.cash].[none:status:nk]' type='palette'><map to='#0ca30c'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#fab219'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#d03b3b'><bucket>&quot;Unmatched&quot;</bucket></map></encoding></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.cash].[none:status:nk]' /><text column='[federated.cash].[sum:amount_usd:qk]' /></encodings>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='true' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[none:exception_reason:nk]</rows>
        <cols>[federated.cash].[sum:amount_usd:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Unmatched cash aging'>
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column datatype='string' name='[aging_bucket]' role='dimension' type='nominal' caption='Age' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column-instance column='[aging_bucket]' derivation='None' name='[none:aging_bucket:nk]' pivot='key' type='nominal' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='Sum' name='[sum:amount_usd:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <filter class='categorical' column='[federated.cash].[none:status:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:status:nk]' member='&quot;Unmatched&quot;' /></groupfilter></filter><sort class='manual' column='[federated.cash].[none:aging_bucket:nk]' direction='ASC'><dictionary><bucket>&quot;0-3 days&quot;</bucket><bucket>&quot;4-7 days&quot;</bucket><bucket>&quot;8-14 days&quot;</bucket><bucket>&quot;15+ days&quot;</bucket></dictionary></sort><slices><column>[federated.cash].[none:status:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><text column='[federated.cash].[sum:amount_usd:qk]' /></encodings>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='true' />
              <format attr='mark-color' value='#d03b3b' />
            </style-rule></style>
          </pane>
        </panes>
        <rows>[federated.cash].[sum:amount_usd:qk]</rows>
        <cols>[federated.cash].[none:aging_bucket:nk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Close dashboard'>
      <layout-options><title><formatted-text>
        <run bold='true' fontsize='16'>Northwind Outfitters · November 2026 close · cash reconciliation</run>
      </formatted-text></title></layout-options>
      <style />
      <size maxheight='820' maxwidth='1200' minheight='820' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='title' w='98000' x='1000' y='1000' />
          <zone h='12000' id='3' name='Headline' show-title='false' w='70000' x='1000' y='9000' />
          <zone h='12000' id='7' name='Match rate by tier' param='[federated.cash].[none:status:nk]' type-v2='color' w='28000' x='71000' y='9000' />
          <zone h='30000' id='4' name='Match rate by tier' w='98000' x='1000' y='21000' />
          <zone h='48000' id='5' name='Exception queue by reason' w='58000' x='1000' y='51000' />
          <zone h='48000' id='6' name='Unmatched cash aging' w='39000' x='60000' y='51000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height='30'>
    <window class='worksheet' name='Headline'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge></cards></window>
    <window class='worksheet' name='Match rate by tier'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge></cards></window>
    <window class='worksheet' name='Exception queue by reason'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge></cards></window>
    <window class='worksheet' name='Unmatched cash aging'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge></cards></window>
    <window class='dashboard' maximized='true' name='Close dashboard'>
      <viewpoints>
        <viewpoint name='Headline' /><viewpoint name='Match rate by tier' />
        <viewpoint name='Exception queue by reason' /><viewpoint name='Unmatched cash aging' />
      </viewpoints>
      <active id='-1' />
    </window>
  </windows>
</workbook>

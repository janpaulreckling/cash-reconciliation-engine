          <sort class='manual' column='[federated.cash].[none:match_tier:nk]' direction='ASC'><dictionary><bucket>&quot;Tier 1 · Exact&quot;</bucket><bucket>&quot;Tier 2 · Fuzzy&quot;</bucket><bucket>&quot;Tier 3 · One-to-many&quot;</bucket><bucket>&quot;Not matched&quot;</bucket></dictionary></sort>

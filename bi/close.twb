la='FALSE'></calculation></column><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_gap_pp]' derivation='User' name='[usr:Calc_gap_pp:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          

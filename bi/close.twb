<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.2.2 (20262.26.0819.2015)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AnimationOnByDefault />
    <BasicButtonObject />
    <BasicButtonObjectTextSupport />
    <CollapsiblePane />
    <MarkAnimation />
    <SetMembershipControl />
    <VizInTooltipHideWorksheet />
    <WindowsPersistSimpleIdentifiers />
    <WorksheetBackgroundTransparency />
    <ZoneVisibilityControl />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Metric view' datatype='string' name='[p_Metric_View]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cash at stake (USD)&quot;'><calculation class='tableau' formula='&quot;Cash at stake (USD)&quot;' /><members><member value='&quot;Cash at stake (USD)&quot;' /><member value='&quot;Payment count (#)&quot;' /></members></column>
    </datasource>
    <datasource caption='cash_items' inline='true' name='federated.cash' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='cash_items' name='textscan.cash'>
            <connection class='textscan' directory='.' filename='cash_items.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.cash' name='cash_items.csv' table='[cash_items#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='source' ordinal='0' /><column datatype='string' name='source_id' ordinal='1' /><column datatype='date' name='cash_date' ordinal='2' /><column datatype='real' name='amount_usd' ordinal='3' /><column datatype='string' name='customer' ordinal='4' /><column datatype='string' name='status' ordinal='5' /><column datatype='string' name='match_tier' ordinal='6' /><column datatype='string' name='exception_code' ordinal='7' /><column datatype='string' name='exception_reason' ordinal='8' /><column datatype='string' name='severity' ordinal='9' /><column datatype='date' name='as_of_date' ordinal='10' /><column datatype='integer' name='age_days' ordinal='11' /><column datatype='string' name='aging_bucket' ordinal='12' /></columns>
        </relation>
      </connection>
      <column datatype='string' name='[source]' role='dimension' type='nominal' /><column datatype='string' name='[source_id]' role='dimension' type='nominal' caption='Ref ID' /><column datatype='date' name='[cash_date]' role='dimension' type='ordinal' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column datatype='string' name='[customer]' role='dimension' type='nominal' caption='Customer' /><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='string' name='[match_tier]' role='dimension' type='nominal' caption='Match tier' /><column datatype='string' name='[exception_code]' role='dimension' type='nominal' /><column datatype='string' name='[exception_reason]' role='dimension' type='nominal' caption='Reason' /><column datatype='string' name='[severity]' role='dimension' type='nominal' /><column datatype='date' name='[as_of_date]' role='dimension' type='ordinal' /><column datatype='integer' name='[age_days]' role='measure' type='quantitative' /><column datatype='string' name='[aging_bucket]' role='dimension' type='nominal' caption='Age' /><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column caption='Share of all payments' datatype='real' name='[Calc_share]' role='measure' type='quantitative' default-format='p0.0%'><calculation class='tableau' formula='SUM([Number of Records]) / MIN({FIXED : SUM([Number of Records])})'></calculation></column><column caption='Selected metric' datatype='real' name='[Calc_metric]' role='measure' type='quantitative' default-format='n#,##0'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN SUM([Number of Records]) ELSE SUM([amount_usd]) END'></calculation></column><column caption='Metric prefix' datatype='string' name='[Calc_prefix]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [Parameters].[p_Metric_View] = &quot;Payment count (#)&quot; THEN &quot;&quot; ELSE &quot;$&quot; END'></calculation></column><column caption='SLA note' datatype='string' name='[Calc_sla_note]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [age_days] > 7 THEN &quot;   Past 7d SLA&quot; ELSE &quot;&quot; END'></calculation></column><column caption='Gap to target (pp)' datatype='real' name='[Calc_gap_pp]' role='measure' type='quantitative' default-format='n+#,##0&quot; pp&quot;;−#,##0&quot; pp&quot;'><calculation class='tableau' formula='ROUND(([Calc_rate] - 0.85) * 100, 0)'></calculation></column><column caption='Target auto-match rate' datatype='real' name='[Calc_target]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='MIN(0.85)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column caption='Customer / payer' datatype='string' name='[Calc_payer]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([customer]) OR [customer] = &quot;&quot; THEN &quot;Unknown payer&quot; ELSE [customer] END'></calculation></column><column caption='Close state' datatype='string' name='[Calc_close_state]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;Blocked&quot; ELSE &quot;Ready&quot; END'></calculation></column><column caption='Close status' datatype='string' name='[Calc_close_label]' role='measure' type='nominal'><calculation class='tableau' formula='IF [Calc_review] > 0 THEN &quot;●  Close blocked · &quot; + STR([Calc_review]) + &quot; items · $&quot; + STR(ROUND([Calc_review_usd] / 1000, 1)) + &quot;k to clear&quot; ELSE &quot;●  Ready to close&quot; END'></calculation></column><column caption='Cumulative cash' datatype='real' name='[Calc_wf_end]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='RUNNING_SUM(SUM([amount_usd]))'><table-calc ordering-field='[federated.cash].[none:status:nk]' ordering-type='Field' /></calculation></column><column caption='Cash received (month)' datatype='real' name='[Calc_wf_total]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='MIN({FIXED : SUM([amount_usd])})'></calculation></column><column caption='Step' datatype='real' name='[Calc_wf_size]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='-SUM([amount_usd])'></calculation></column><column caption='Age (days)' datatype='integer' name='[Calc_age]' role='measure' type='quantitative'><calculation class='tableau' formula='MIN([age_days])'></calculation></column><column caption='Rank by amount' datatype='integer' name='[Calc_rank]' role='measure' type='quantitative'><calculation class='tableau' formula='RANK_UNIQUE(SUM([amount_usd]))'><table-calc ordering-type='Rows' /></calculation></column>
      <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calc_close_state]' derivation='User' name='[usr:Calc_close_state:nk]' pivot='key' type='nominal' />
      <column-instance column='[aging_bucket]' derivation='None' name='[none:aging_bucket:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style><style-rule element='mark'>
        <encoding attr='color' field='[none:status:nk]' type='palette'><map to='#1D4ED8'><bucket>&quot;Auto-matched&quot;</bucket></map><map to='#64748B'><bucket>&quot;Matched, needs review&quot;</bucket></map><map to='#B45309'><bucket>&quot;Unmatched&quot;</bucket></map></encoding>
        <encoding attr='color' field='[none:aging_bucket:nk]' type='palette'><map to='#FDBA74'><bucket>&quot;0-3 days&quot;</bucket></map><map to='#EA580C'><bucket>&quot;4-7 days&quot;</bucket></map><map to='#9A3412'><bucket>&quot;8-14 days&quot;</bucket></map><map to='#7C2D12'><bucket>&quot;15+ days&quot;</bucket></map></encoding>
        <encoding attr='color' field='[usr:Calc_close_state:nk]' type='palette'><map to='#B91C1C'><bucket>&quot;Blocked&quot;</bucket></map><map to='#15803D'><bucket>&quot;Ready&quot;</bucket></map></encoding>
      </style-rule></style>
    </datasource>
  </datasources>
  <actions>
    <action caption='Filter from Match rate by tier' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Match rate by tier' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Match rate by tier' />
        <param name='special-fields' value='all' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Filter from Exception queue by reason' name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Exception queue by reason' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Exception queue by reason' />
        <param name='special-fields' value='all' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Filter from Unmatched cash aging' name='[Action3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Unmatched cash aging' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Unmatched cash aging' />
        <param name='special-fields' value='all' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Filter from Cash waterfall' name='[Action4]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Cash waterfall' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Cash waterfall' />
        <param name='special-fields' value='all' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='KPI tiles: no selection' name='[Action9]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Close dashboard' type='sheet'><exclude-sheet name='Match rate by tier' /><exclude-sheet name='Exception queue by reason' /><exclude-sheet name='Unmatched cash aging' /><exclude-sheet name='Action_Table' /><exclude-sheet name='Cash waterfall' /></source>
      <link caption='KPI tiles: no selection' delimiter=',' escape='\' expression='tsl:Close%20dashboard?%5Bfederated.cash%5D.%5BCalc_false%5D~s0=&lt;[Calc_true]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Match rate by tier,Exception queue by reason,Unmatched cash aging,Action_Table,Cash waterfall' />
        <param name='target' value='Close dashboard' />
      </command>
    </action>
    <action caption='Open &lt;[federated.cash].[none:source_id:nk]&gt; in the review app' name='[Action10]'>
      <activation type='on-select' />
      <source dashboard='Close dashboard' type='sheet' worksheet='Action_Table' />
      <link caption='Open in the review app' expression='https://northwind-cash-recon.streamlit.app/?item=&lt;[federated.cash].[none:source_id:nk]~na&gt;' url-escape='true' />
    </action>
  </actions>
  <worksheets>
    <worksheet name='KPI rate'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Gap to target (pp)' datatype='real' name='[Calc_gap_pp]' role='measure' type='quantitative' default-format='n+#,##0&quot; pp&quot;;−#,##0&quot; pp&quot;'><calculation class='tableau' formula='ROUND(([Calc_rate] - 0.85) * 100, 0)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_gap_pp]' derivation='User' name='[usr:Calc_gap_pp:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='table'><format attr='background-color' value='#ffffff' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.cash].[usr:Calc_rate:qk]' /><text column='[federated.cash].[usr:Calc_gap_pp:qk]' /><lod column='[federated.cash].[none:Calc_true:nk]' /><lod column='[federated.cash].[none:Calc_false:nk]' /></encodings><customized-label><formatted-text><run fontcolor='#1D4ED8' fontname='Tableau Semibold' fontsize='28'>&lt;[federated.cash].[usr:Calc_rate:qk]&gt;</run><run>Æ&#10;</run><run fontcolor='#475569' fontname='Tableau Book' fontsize='10'>of payments matched automatically</run><run>Æ&#10;</run><run fontcolor='#64748B' fontname='Tableau Book' fontsize='9'>Target 85% · &lt;[federated.cash].[usr:Calc_gap_pp:qk]&gt;</run></formatted-text></customized-label>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='text-align' value='left' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='KPI rate bar'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='Target auto-match rate' datatype='real' name='[Calc_target]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='MIN(0.85)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_target]' derivation='User' name='[usr:Calc_target:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.cash].[usr:Calc_rate:qk]' field-type='quantitative' max='1.0' min='0.0' range-type='fixed' scope='cols' type='space' /><format attr='display' class='0' field='[federated.cash].[usr:Calc_rate:qk]' scope='cols' value='false' /></style-rule><style-rule element='refline'><format attr='stroke-color' id='refline0' value='#172033' /><format attr='stroke-size' id='refline0' value='2' /></style-rule><style-rule element='table'><format attr='background-color' value='#E5E7EB' /></style-rule><style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='mark'><format attr='mark-color' value='#1D4ED8' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><lod column='[federated.cash].[usr:Calc_target:qk]' /><lod column='[federated.cash].[none:Calc_true:nk]' /><lod column='[federated.cash].[none:Calc_false:nk]' /></encodings><reference-line axis-column='[federated.cash].[usr:Calc_rate:qk]' enable-instant-analytics='false' formula='max' id='refline0' label-type='none' scope='per-table' value-column='[federated.cash].[usr:Calc_target:qk]' z-order='1' /><customized-tooltip><formatted-text><run fontcolor='#172033' fontname='Tableau Book' fontsize='10'>Target 85% auto-match rate · today &lt;[federated.cash].[usr:Calc_rate:qk]&gt;</run></formatted-text></customized-tooltip>
            <style><style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' /><format attr='size' value='1.0' /><format attr='mark-labels-show' value='false' />
            </style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols>[federated.cash].[usr:Calc_rate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='KPI payments'>
      
      <table>
        <view>
          <datasources><datasource caption='cash_items' name='federated.cash' /></datasources>
          <datasource-dependencies datasource='federated.cash'><column caption='Auto-match rate' datatype='real' name='[Calc_rate]' role='measure' type='quantitative' default-format='p0%'><calculation class='tableau' formula='[Calc_auto] / SUM([Number of Records])'></calculation></column><column caption='Auto-matched' datatype='integer' name='[Calc_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([status]=&quot;Auto-matched&quot;,1,0))'></calculation></column><column caption='Payments' datatype='integer' name='[Number of Records]' role='measure' type='quantitative'><calculation class='tableau' formula='1'></calculation></column><column caption='To review' datatype='integer' name='[Calc_review]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Number of Records]) - [Calc_auto]'></calculation></column><column caption='Cash to review' datatype='real' name='[Calc_review_usd]' role='measure' type='quantitative' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0'><calculation class='tableau' formula='SUM(IIF(NOT [status]=&quot;Auto-matched&quot;,[amount_usd],0))'></calculation></column><column datatype='string' name='[status]' role='dimension' type='nominal' caption='Status' /><column datatype='real' name='[amount_usd]' role='measure' type='quantitative' caption='Amount' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' /><column caption='Gap to target (pp)' datatype='real' name='[Calc_gap_pp]' role='measure' type='quantitative' default-format='n+#,##0&quot; pp&quot;;−#,##0&quot; pp&quot;'><calculation class='tableau' formula='ROUND(([Calc_rate] - 0.85) * 100, 0)'></calculation></column><column caption='No-select source' datatype='boolean' name='[Calc_true]' role='dimension' type='nominal'><calculation class='tableau' formula='TRUE'></calculation></column><column caption='No-select target' datatype='boolean' name='[Calc_false]' role='dimension' type='nominal'><calculation class='tableau' formula='FALSE'></calculation></column><column-instance column='[Calc_rate]' derivation='User' name='[usr:Calc_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_auto]' derivation='User' name='[usr:Calc_auto:qk]' pivot='key' type='quantitative' /><column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review]' derivation='User' name='[usr:Calc_review:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_review_usd]' derivation='User' name='[usr:Calc_review_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[amount_usd]' derivation='None' name='[none:amount_usd:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_gap_pp]' derivation='User' name='[usr:Calc_gap_pp:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_true]' derivation='None' name='[none:Calc_true:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_false]' derivation='None' name='[none:Calc_false:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style><style-rule element='table'><format attr='background-color' value='#ffffff' /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />

    <worksheet name='Match rate by tier'>
      <layout-options><title><formatted-text><run fontcolor='#172033' fontname='Tableau Semibold' fontsize='12'>How payments were matched · share of all payments (%)</run></formatted-text></title></layout-options>
      <table>

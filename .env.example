# Copy to .env (never commit .env)

RECON_DUCKDB_PATH=./recon.duckdb

# Odoo (read-only; docker-compose of order-to-cash-sync)
RECON_ODOO_URL=http://localhost:8069
RECON_ODOO_DB=northwind
RECON_ODOO_USERNAME=admin
RECON_ODOO_PASSWORD=admin

# Stripe test mode (sk_test_... only; live keys are rejected)
RECON_STRIPE_API_KEY=
# Connected test merchant the platform key acts for (see docs/stripe_setup.md)
RECON_STRIPE_ACCOUNT=

# Plaid Sandbox
RECON_PLAID_CLIENT_ID=
RECON_PLAID_SECRET=
